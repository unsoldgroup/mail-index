{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mail-index",
  "main": "oauth.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "mail-index", "database_id": "replace-with-operator-d1-id" }
  ],
  "queues": {
    "producers": [{ "binding": "SYNC_QUEUE", "queue": "mail-index-jobs" }],
    // One Job per invocation — see the note in wrangler.production.jsonc.
    "consumers": [{ "queue": "mail-index-jobs", "max_batch_size": 1, "max_concurrency": 3, "max_retries": 3 }]
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "replace-with-operator-kv-id" }
  ],
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "mail-index-attachments" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 }
  // 30s gives 2.69× headroom over the 11.15s 1,000-Message measurement in bench/RESULTS-WORKER.md.
  ,"limits": { "cpu_ms": 30000 }
  ,"triggers": { "crons": ["0 * * * *"] }
  ,"vars": { "SYNC_INTERVAL": "1h", "SYNC_LOOKBACK_MONTHS": "240", "OPERATOR_EMAILS": "operator@example.com" }

  // Secrets (set with `wrangler secret put`):
  // TOKEN_ENC_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, CRM_WEBHOOK_SECRET.
  // CRM_WEBHOOK_URL is a non-secret optional variable for the Twenty App callback.
  // OPERATOR_EMAILS is a comma-separated non-secret allowlist variable.
}
