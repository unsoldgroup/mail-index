{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mail-index",
  "main": "oauth.ts",
  "compatibility_date": "2026-07-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB", "database_name": "mail-index", "database_id": "14c712df-bc59-4f97-aeda-d304c97ddb4c" }
  ],
  "queues": {
    "producers": [
      { "binding": "SYNC_QUEUE", "queue": "mail-index-jobs" },
      { "binding": "SWEEP_QUEUE", "queue": "mail-index-sweeps" }
    ],
    // max_batch_size MUST stay 1. The consumer runs a batch SERIALLY in one
    // invocation, so any larger batch makes several whole sync pipelines share
    // a single 30s CPU budget. When that budget runs out the isolate is killed
    // mid-Job: the D1 writes already made survive, but the final
    // `update('done')` never lands, leaving rows stuck at `running` with empty
    // progress — and a stuck row suppresses the next enqueue for that Account.
    // One Job per invocation gives each the full budget.
    //
    // The sync lock is per ACCOUNT, so concurrency is capped at roughly one
    // invocation per connected mailbox rather than one globally. Serialising
    // everything made a tick drain slower than the hour that queues it, and
    // starved whichever kind the cron enqueues last (the historical backfill).
    // Same-Account collisions are handled in the Job itself, which yields the
    // tick instead of failing.
    //
    // max_retries is bounded so a Job that kills its isolate stops being
    // redelivered forever; the Job row's lease is what reclaims it after that.
    // Two Queues, two concurrency budgets. A `sync` is unbounded O(mailbox)
    // work: one holds its slot for 8-15 minutes and sometimes dies at the
    // Workers 15-minute WALL limit (observed: a single invocation at 899,982ms,
    // outcome exceededWallTime). With one slot per connected mailbox on a single
    // Queue, syncs held every slot for most of the hour and the bounded sweeps
    // sat queued until their 50-minute lease expired — reaped as "queued Job was
    // never delivered" while the cron itself reported outcome ok. Giving the
    // sweeps their own Queue means a slow sync can no longer starve them.
    //
    // Both stay at max_batch_size 1 for the reason above, and both cap
    // concurrency at the connected-mailbox count because the sync lock is per
    // Account — more invocations than mailboxes just yield.
    "consumers": [
      { "queue": "mail-index-jobs", "max_batch_size": 1, "max_concurrency": 3, "max_retries": 3 },
      { "queue": "mail-index-sweeps", "max_batch_size": 1, "max_concurrency": 3, "max_retries": 3 }
    ]
  },
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "3a709f7cc8884412aacb9347345a90ad" }
  ],
  "r2_buckets": [
    { "binding": "ATTACHMENTS", "bucket_name": "mail-index-attachments" }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "limits": { "cpu_ms": 30000 },
  "triggers": { "crons": ["0 * * * *"] },
  "vars": {
    "SYNC_INTERVAL": "1h",
    "SYNC_LOOKBACK_MONTHS": "240",
    "OPERATOR_EMAILS": "al@unsold.group,alexandre.stemarie@gmail.com,alex.stemarie@fora.travel",
    "CRM_WEBHOOK_URL": "https://ei.unsold.cloud/s/mail-index/completed"
  }
}
